<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:startColor="#4aa6f0" android:endColor="#0a63b0" android:angle="270" />
            <corners android:radius="6dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <gradient android:startColor="#4aa6f0" android:endColor="#0a63b0" android:angle="270" />
            <corners android:radius="6dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:startColor="#555555" android:endColor="#2e2e2e" android:angle="270" />
            <stroke android:width="1dp" android:color="@color/belle_line" />
            <corners android:radius="6dp"/>
        </shape>
    </item>
</selector>
